{
  "info": {
    "name": "Tech Challenge Fase 2 - Restaurantes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Tipos de usuário",
      "item": [
        {
          "name": "Criar tipo (Dono de Restaurante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user-types"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dono de Restaurante\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 ou 409',()=>pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar tipos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user-types"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t=pm.response.json().find(x=>x.name==='Dono de Restaurante');if(t)pm.collectionVariables.set('ownerTypeId',t.id);pm.collectionVariables.set('userTypeId',t?t.id:'');"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar tipo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user-types",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user-types"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gerente\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('extraTypeId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar tipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
